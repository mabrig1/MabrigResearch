# ── Server ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # change to: production

# ── Database ─────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Connect your application
MONGO_URI=mongodb+srv://mabrigAdmin:<db_password>@learnhub.07ozegd.mongodb.net/mabrig_research?appName=learnhub

# ── Auth ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=7d

# ── Paystack ─────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com/#/settings/developer
# Use sk_test_xxx for dev, sk_live_xxx for production
PAYSTACK_SECRET=sk_test_your_paystack_secret_key

# ── App ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5500   # change to: https://mabrigresearch.online
